#!/bin/bash
# Float windows while Workbench 1.3 is current (no tiling snap).
# On any other theme, restore windows this hook floated.

THEME="${1:-}"
THEME_SLUG="workbench-1.3"
TAG="wb13-float"

float_tiled() {
  python3 - "$TAG" <<'PY'
import json, subprocess, sys

tag = sys.argv[1]

def dispatch(lua, *legacy):
    r = subprocess.run(["hyprctl", "dispatch", lua], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if r.returncode != 0 and legacy:
        subprocess.run(["hyprctl", "dispatch", *legacy], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

try:
    clients = json.loads(subprocess.check_output(["hyprctl", "-j", "clients"]))
except Exception:
    raise SystemExit(0)

for client in clients:
    addr = client.get("address") or ""
    if not addr:
        continue
    window = f"address:{addr}"
    tags = client.get("tags") or []
    tagged = any(str(t).rstrip("*") == tag for t in tags)
    if not client.get("floating"):
        dispatch(
            f'hl.dsp.window.float({{ window = "{window}", action = "set" }})',
            "setfloating",
            window,
        )
    if not tagged:
        dispatch(
            f'hl.dsp.window.tag({{ window = "{window}", tag = "+{tag}" }})',
            "tagwindow",
            f"+{tag}",
            window,
        )
PY
}

tile_restored() {
  python3 - "$TAG" <<'PY'
import json, subprocess, sys

tag = sys.argv[1]

def dispatch(lua, *legacy):
    r = subprocess.run(["hyprctl", "dispatch", lua], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if r.returncode != 0 and legacy:
        subprocess.run(["hyprctl", "dispatch", *legacy], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

try:
    clients = json.loads(subprocess.check_output(["hyprctl", "-j", "clients"]))
except Exception:
    raise SystemExit(0)

for client in clients:
    tags = client.get("tags") or []
    if not any(str(t).rstrip("*") == tag for t in tags):
        continue
    addr = client.get("address") or ""
    if not addr:
        continue
    window = f"address:{addr}"
    if client.get("floating"):
        dispatch(
            f'hl.dsp.window.float({{ window = "{window}", action = "unset" }})',
            "togglefloating",
            window,
        )
    dispatch(
        f'hl.dsp.window.tag({{ window = "{window}", tag = "-{tag}" }})',
        "tagwindow",
        f"-{tag}",
        window,
    )
PY
}

if [[ $THEME == "$THEME_SLUG" ]]; then
  float_tiled
else
  tile_restored
fi
